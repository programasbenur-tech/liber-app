# =============================================================================
# LIBER ❤️ — Environment Variables Example
# Copy to .env.local for local development. NEVER commit .env.local or secrets.
# =============================================================================

# --- Supabase (Optional in Local Demo Mode) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Server-only! NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# --- Feature Flags ---
# Competition mode MUST remain false by default
NEXT_PUBLIC_ENABLE_COUPLE_COMPETITIONS=false

# --- Mercado Pago Brasil & Uruguay (Keep false until credentials are configured) ---
PAYMENTS_ENABLED=false
MP_ENVIRONMENT=sandbox
MP_ACCESS_TOKEN_BR=your-mercadopago-brasil-access-token
MP_ACCESS_TOKEN_UY=your-mercadopago-uruguay-access-token
MP_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# --- App URL (for Auth & Mercado Pago callbacks) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
